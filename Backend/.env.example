# PromptLab backend sample environment
# Copy this file to .env and replace placeholder values.

# Required for Groq-backed AI features.
# Add as many numbered keys as needed. Empty keys are ignored.
GROK_API_KEY_1=your_first_grok_api_key_here
GROK_API_KEY_2=your_second_grok_api_key_here
GROK_API_KEY_3=your_third_grok_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Areeba email verification, password reset, and reminder emails.
# For Gmail, use an app password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_app_password_here

# Service integration URLs.
AREEBA_API=http://127.0.0.1:5001

# Local SQLite database paths. Relative paths are created in the service folder.
FATIMA_DB_PATH=fatima_learning.db
RABIA_DB_PATH=rabia_enhancer.db

# Learning/practice settings.
PRACTICE_PASSING_SCORE=70

# Rabia enhancer settings.
RABIA_PORT=5003
RABIA_USE_GROQ=false

# Flask/runtime settings.
FLASK_DEBUG=false

# Areeba reminder scheduler settings.
INACTIVE_DAYS=7
